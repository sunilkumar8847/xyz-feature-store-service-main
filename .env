# ================================================================
# Feature Store Service — Base Configuration
# .env  (committed — no secrets)
#
# Config loads: .env → .env.local (later overrides earlier)
# See src/core/config.py for all supported settings.
#
# Git-ignored secret files:
#   .env.local       → local secrets
#   .env.dev         → dev secrets (CI/CD injected)
#   .env.stg         → staging secrets
#   .env.integration → integration secrets
#   .env.prd         → production secrets
# ================================================================

# Service Identity
SERVICE_NAME=feature-store
SERVICE_VERSION=3.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8115
API_WORKERS=1
API_RELOAD=true
DOCS_URL=/swagger-ui.html
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# PostgreSQL — shared platform infra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xyzmdm
POSTGRES_USER=xyzmdm
POSTGRES_POOL_SIZE=20

# Redis — shared platform infra
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=0.5

# S3 — LocalStack shared infra
S3_BUCKET=xyz-mdm-feature-store
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566

# Kafka — shared platform infra
KAFKA_BROKERS=localhost:9092
KAFKA_ENTITY_EVENTS_TOPIC=mdm.entity.events
KAFKA_CONSUMER_GROUP=feature-store-consumer

# Feature Configuration
FEATURE_VERSION=v2.0.0
FEATURE_TTL_HOURS=24
FEATURE_BATCH_SIZE=100
MATERIALIZATION_CRON=0 2 * * *

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Drift Detection
DRIFT_CHECK_INTERVAL_SECONDS=3600
DRIFT_KL_THRESHOLD=0.1
DRIFT_JS_THRESHOLD=0.05

# Observability
PROMETHEUS_PORT=9090
OTLP_ENDPOINT=

# External Services — standardized ports
MODEL_INFERENCE_SERVICE_URL=http://localhost:8090
LINEAGE_SERVICE_URL=http://localhost:8095
