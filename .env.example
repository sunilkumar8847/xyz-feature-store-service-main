# ─── Service Identity ─────────────────────────────────────────────────────────
SERVICE_NAME=feature-store
SERVICE_VERSION=3.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8006
API_WORKERS=4
API_RELOAD=false

# ─── PostgreSQL (Feature Registry) ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=feature_store
POSTGRES_USER=feature_store_user
POSTGRES_PASSWORD=feature_store_pass
POSTGRES_POOL_SIZE=20

# ─── Redis (Online Store) ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Uncomment for auth
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=0.5

# ─── S3 (Offline Store) ───────────────────────────────────────────────────────
S3_BUCKET=xyz-mdm-feature-store
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key          # Leave unset to use IAM role in prod
# AWS_SECRET_ACCESS_KEY=your_secret   # Leave unset to use IAM role in prod
S3_ENDPOINT_URL=https://localhost:4566  # Remove in production (LocalStack only)
AWS_CA_BUNDLE=false

# ─── Kafka (Streaming) ────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_ENTITY_EVENTS_TOPIC=mdm.entity.events
KAFKA_CONSUMER_GROUP=feature-store-consumer

# ─── Feature Configuration ────────────────────────────────────────────────────
FEATURE_VERSION=v2.0.0
FEATURE_TTL_HOURS=24
FEATURE_BATCH_SIZE=100
MATERIALIZATION_CRON=0 2 * * *

# ─── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Drift Detection ──────────────────────────────────────────────────────────
DRIFT_CHECK_INTERVAL_SECONDS=3600
DRIFT_KL_THRESHOLD=0.1
DRIFT_JS_THRESHOLD=0.05

# ─── External Services ────────────────────────────────────────────────────────
MODEL_INFERENCE_SERVICE_URL=http://localhost:8000
LINEAGE_SERVICE_URL=http://localhost:8004
