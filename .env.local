# ================================================================
# Feature Store Service — Local Secrets (git-ignored)
# Points at the shared infra stack in ../../infra/docker-compose.yml
# ================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
API_RELOAD=false

# PostgreSQL — matches infra/docker-compose.yml (host 5442; native Windows pg holds 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
POSTGRES_PASSWORD=xyzmdm_local_secret
# Own database (created by infra/postgres-init/init.sql). NOT xyzmdm: training's
# migrations live there and use the same Alembic revision id "001_initial", so
# running feature-store migrations in xyzmdm would silently skip creating tables.
POSTGRES_DB=feature_store

# Redis — shared infra runs with NO auth; leave blank
REDIS_PASSWORD=

# AWS LocalStack credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
