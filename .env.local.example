# ================================================================
# Feature Store Service — Local Secrets Example
# .env.local.example  (committed)
#
# Copy to .env.local:
#   cp .env.local.example .env.local
#
# Prerequisites:
#   1. Platform infra running (PostgreSQL, Redis, Kafka, LocalStack):
#        cd C:\XYZFusion\platform\docker
#        docker compose -f docker-compose.infra.yml up -d
#
#   2. Install dependencies:
#        pip install -e ".[dev]"
#        OR
#        pip install -e .
#
#   3. Run migrations:
#        alembic upgrade head
#
#   4. Run: make run-local
#
# NOTE: First install downloads sentence-transformers + torch (~2GB).
# This takes 10-15 minutes on first run.
# ================================================================

ENVIRONMENT=local
LOG_LEVEL=DEBUG
API_RELOAD=true

# PostgreSQL password
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# Redis password
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# AWS LocalStack credentials (use test/test for local)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
